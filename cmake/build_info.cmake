# cmake -DSOURCE_DIR=... -DOUTPUT=... -DBUILD_TYPE=... [-DCOMPILER=... -DSANITIZE=...
#       -DPLATFORM=...] -P build_info.cmake
#
# Writes OUTPUT, a header with the commit SOURCE_DIR is at, whether tracked
# files differ from it (untracked files, e.g. bench results, do not count), the
# source digest, and the build type, compiler, sanitizers and platform it is
# given. Runs on every build; file(CONFIGURE) rewrites OUTPUT only when it
# changes.

execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE changes ERROR_QUIET)

if(failed)
    set(commit "unknown")
endif()
if(changes STREQUAL "")
    set(dirty false)
else()
    set(dirty true)
endif()

# The source digest: SHA-256 over the path and SHA-256 of every file git tracks or would add under the source
# directories, so two trees at one commit that differ by an uncommitted or untracked file get different digests.
execute_process(COMMAND git -C "${SOURCE_DIR}" -c core.quotePath=false ls-files --cached --others --exclude-standard
                        -- include src app server cmake CMakeLists.txt
    OUTPUT_VARIABLE files OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE unlisted)
string(REPLACE "\n" ";" files "${files}")
list(SORT files)
set(manifest "")
foreach(file IN LISTS files)
    if(EXISTS "${SOURCE_DIR}/${file}")  # a deleted tracked file is still listed
        file(SHA256 "${SOURCE_DIR}/${file}" hash)
        string(APPEND manifest "${file} ${hash}\n")
    endif()
endforeach()
if(unlisted)
    set(source_digest "unknown")
else()
    string(SHA256 source_digest "${manifest}")
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT [[#pragma once

// Generated by cmake/build_info.cmake on every build.
inline constexpr const char* build_commit = "@commit@";
inline constexpr bool build_dirty = @dirty@;
inline constexpr const char* build_type = "@BUILD_TYPE@";
inline constexpr const char* build_source_digest = "@source_digest@";
inline constexpr const char* build_compiler = "@COMPILER@";
inline constexpr const char* build_sanitize = "@SANITIZE@";
inline constexpr const char* build_platform = "@PLATFORM@";
]])
