# cmake -DSOURCE_DIR=... -DOUTPUT=... -DBUILD_TYPE=... -P build_info.cmake
#
# Writes OUTPUT, a header with the commit SOURCE_DIR is at and whether tracked
# files differ from it (untracked files, e.g. bench results, do not count).
# Runs on every build; file(CONFIGURE) rewrites OUTPUT only when it changes.

execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE changes ERROR_QUIET)

if(failed)
    set(commit "unknown")
endif()
if(changes STREQUAL "")
    set(dirty false)
else()
    set(dirty true)
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT [[#pragma once

// Generated by cmake/build_info.cmake on every build.
inline constexpr const char* build_commit = "@commit@";
inline constexpr bool build_dirty = @dirty@;
inline constexpr const char* build_type = "@BUILD_TYPE@";
]])
