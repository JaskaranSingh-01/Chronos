# clang-tidy (M4.03): bugprone, performance and modernize checks, minus those
# that flag this codebase's deliberate conventions (noexcept functions that may
# allocate, C buffers for snprintf, no trailing return types or blanket
# [[nodiscard]]) or are style-only noise. Not run in CI yet. Use clang-tidy 20:
#   SDKROOT=$(xcrun --show-sdk-path) clang-tidy -p build src/market/market_book.cpp
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-use-auto,
  -modernize-use-designated-initializers,
  -modernize-use-integer-sign-comparison,
  -modernize-use-nodiscard,
  -modernize-use-ranges,
  -modernize-use-trailing-return-type
HeaderFilterRegex: '\.hpp$'
